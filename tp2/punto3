mostrarBebidas(Min, Max, Producto) :- 
    producto(bebida, Producto), 
    precio(Producto, Precio), 
    Precio >= Min, 
    Precio =< Max.

total([], 0).

total([Producto|Lista], Total):-
    precio(Producto, Precio),
    total(Lista, TotalLista),
    Total is Precio +TotalLista.


% si es una lista vacia queda vacia
eliminarGolosina([], []).

%si el primer elemento es una golosina no la agrego
eliminarGolosina([Producto|Lista], Resultado):-
    producto(golosina, Producto), 
    eliminarGolosina(Lista, Resultado).


%si es golosina los agrega de nuevo a la lista
eliminarGolosina([Producto|Lista], [Producto|Resultado]):-
    \+ producto(golosina, Producto),
    eliminarGolosina(Lista, Resultado).

producto(Categoria, Producto).
precio(Producto, Precio).

promocion(Producto1, Producto2, Total):-
    producto(Categoria1, Producto1),
    producto(Categoria2, Producto2),
    precio(Producto1, Precio1),
    precio(Producto2, Precio2),

    Producto1 \= Producto2,
    Promedio is (Producto1 + Producto2)/2,
    Promedio < 200,
    descuento(Precio1, Precio2, Monto).

descuento(Precio1, Precio2, Monto):-
    Precio1 =< Precio2,
    Monto is Precio1 * 0.30 + Precio2.

descuento(Precio1, Precio2, Monto):-
    Precio2 =< Precio1,
    Monto is Precio2 * 0.30 + Precio1.


